---
const { ads, type } = Astro.props;

if(!ads?.length) return;

let randomAd = Math.floor(Math.random() * ads.length);
const initialAd = ads[randomAd];
const { title, image, cta } = initialAd;
console.log(initialAd);

---

<article data-ads={JSON.stringify(ads)} 
 class={`${type === "secondary" ? "md:hidden" : ""} ad-card w-full h-full rounded-2xl overflow-hidden relative transition-all duration-300`}>
    <a href={cta[0].href} target="_blank" rel="noopener noreferrer">
        <img src={image.url} alt={title}
        class=" w-full h-full rounded-xl object-cover cursor-pointer transition-opacity duration-300" />
        <span class="text-xs md:text-sm w-fit not-prose bg-gray-100 text-gray-800 px-4 py-1 rounded-xl absolute top-2 left-2 md:top-4 md:left-4">Publicidad</span>
    </a>
</article>

<script>
    
    const cards = document.querySelectorAll(".ad-card") as NodeListOf<HTMLElement>;

    cards.forEach((card) => {
      const ads = JSON.parse(card.getAttribute("data-ads") as string);
      let index = Math.floor(Math.random() * ads.length);
      const ad = ads[index];
      const img = card.querySelector("img") as HTMLImageElement;
      const link = card.querySelector("a") as HTMLAnchorElement;
      img.src = ad.image.url;
      img.alt = ad.title;
      link.href = ad.cta[0].href;

      function changeAd() {
        index = (index + 1) % ads.length;
        const ad = ads[index];
        
        img.classList.add("opacity-0");

        setTimeout(() => {
          img.src = ad.image.url;
          img.alt = ad.title;
          link.href = ad.cta[0].href;
          img.classList.remove("opacity-0");
        }, 300);

      }
      setInterval(changeAd, 10000);
    })

</script>