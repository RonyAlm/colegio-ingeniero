---
import AdCard from './AdCard.astro';
import ArrowRightIcon from './icons/ArrowRightIcon.astro';

type ImageItem = {
  url: string;
  alternativeText?: string;
};

type CTA = {
  label: string;
  href: string;
  isExternal?: boolean;
};

interface Props {
  data: PropsData;
}

interface PropsData {
  images?: ImageItem[];
  title?: string;
  description?: string;
  cta?: CTA[];
  bgColor?: string;
}

const { data } = Astro.props as Props;
if(!data) return
const { images, title, description, cta, bgColor = "bg-green-200" } = data as PropsData;

const ads = [
  {
    title: "Ad 1",
    description: "Ad 1",
    image: "https://res.cloudinary.com/du86bx5o0/image/upload/v1784816443/ad_card_2_ad186aafb7.jpg",
    cta: "https://google.com/1"
  },
  {
    title: "Ad 2",
    description: "Ad 2",
    image: "https://res.cloudinary.com/du86bx5o0/image/upload/v1784816443/ad_card_2_ad186aafb7.jpg",
    cta: "https://google.com/2"
  }
]


---

<div
  data-wrapper
  class="fixed inset-0 z-50 flex items-center justify-center"
>
  <!-- Overlay -->
  <div class="absolute inset-0 bg-green-200/80 backdrop-blur-sm"></div>

  <div class="relative w-full h-full flex items-center justify-center">

    <button
      type="button"
      data-close
      aria-label="Cerrar"
      class="cursor-pointer absolute top-5 right-5 z-50 text-green-950 text-3xl
       font-bold hover:scale-110 transition">
      ✕
    </button>

      <div class="flex flex-col items-center justify-center relative w-full">
      
        <div class="flex flex-wrap gap-4 items-center justify-center p-4 w-full h-fit">

          { images?.slice(0, 3).map((img) => (
            <div class="h-fit animate-fade-in mt-10 md:mt-0">
              <a 
                class="h-100 md:h-125 flex items-center justify-center cursor-pointer"
                target="_blank" href={cta && cta.length > 0 ? cta[0].href : "#" }>
                <img
                  src={img.url}
                  alt={img.alternativeText ?? "promo"}
                  class="rounded-2xl shadow w-full h-full object-cover"
                />
              </a>
              { cta && cta.length > 0 && (
                <div class="hidden md:flex items-center justify-center mt-4">
                  <a class="flex items-center bg-green-600 uppercase
                  text-white px-6 py-3 rounded-full font-semibold hover:bg-green-700 transition
                    border-4 border-green-300 animate-rubber-band"
                    href={cta[0].href} target="_blank"> 
                    <span>{cta[0].label}</span>
                    <ArrowRightIcon class="h-6 w-6 ml-2" />
                   </a>
                </div>
              )}               
            </div>
            
          ))}
          <div class="h-100 md:h-125 animate-fade-in md:mb-18">
            <AdCard ads={ads} />
          </div>
                
        </div>
    
      </div>
      
  </div>

</div>

<script>
  (() => {
    // Tomamos el primer banner (o podrías usar querySelectorAll si tenés varios)
    const wrapper = document.querySelector('[data-wrapper]');
    if (!(wrapper instanceof HTMLElement)) return;

    const closeBtn = wrapper.querySelector('[data-close]');

    let timeoutId = setTimeout(() => {
      wrapper.classList.add("hidden");
    }, 10000);

    // ❌ Botón cerrar
    if (closeBtn instanceof HTMLElement) {
      closeBtn.addEventListener("click", () => {
        wrapper.classList.add("hidden");
        clearTimeout(timeoutId);
      });
    }

    // ❌ Click fuera (IMPORTANTE: corregido)
    wrapper.addEventListener("click", (e) => {
      if (e.target === wrapper) {
        wrapper.classList.add("hidden");
        clearTimeout(timeoutId);
      }
    });

    // ❌ ESC
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        wrapper.classList.add("hidden");
        clearTimeout(timeoutId);
      }
    });
  })();
</script>