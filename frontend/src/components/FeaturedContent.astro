---
import { getHomePage } from "../lib/strapi";
import { findBlock } from "../utils";
import AdCard from "./AdCard.astro";
import CardContent from "./CardContent.astro";
import HeadingText from "./HeadingText.astro";
import LinkCta from "./LinkCta.astro";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
const { data } = Astro.props;
if(!data) return
const { title, description, cta, items } = data;

const adsCard = {
  heading: "Ad Card ",
  description: "Ad Card  Description",
  ads: [
    {
      id: 1,
      title: "Ad 1",
      description: "Ad description",
      image: {
        url: "https://res.cloudinary.com/du86bx5o0/image/upload/v1784816443/ad_card_1_09a215bd8b.jpg"
      },
      cta: [
        {
          label: "CTA 1",
          href: "https://google.com/1",
          isExternal: true
        },
      ]
    },
    {
      id: 2,
      title: "Ad 2",
      description: "Ad description",
      image: {
        url: "https://res.cloudinary.com/du86bx5o0/image/upload/v1784816443/ad_card_2_ad186aafb7.jpg"
      },
      cta: [
        {
          label: "CTA 2",
          href: "https://google.com/2",
          isExternal: true
        },
      ]
    },
  ]
}

const adsSiderbarMobile = {
  heading: "Ad Siderbar Mobile",
  description: "Ad Siderbar Mobile Description",
  ads: [
    {
      id: 1,
      title: "Ad 1",
      description: "Ad description",
      image: {
        url: "https://res.cloudinary.com/du86bx5o0/image/upload/v1784820270/ad_horizontal_8028cdab33.jpg"
      },
      cta: [
        {
          label: "CTA 1",
          href: "https://google.com/1",
          isExternal: true
        },
      ]
    },
    {
      id: 2,
      title: "Ad 2",
      description: "Ad description",
      image: {
        url: "https://res.cloudinary.com/du86bx5o0/image/upload/v1784820270/ad_horizontal_8028cdab33.jpg"
      },
      cta: [
        {
          label: "CTA 2",
          href: "https://google.com/2",
          isExternal: true
        },
      ]
    },
  ]
}

let itemsCard = [] as any;

items.forEach((item: any, index : number) => {
  itemsCard.push({
    type: "content",
    data: item
  });

  if(index  === 3) {
    itemsCard.push({
      type: "ad"
    })
  }
})

---

<section id="featured-content" class="container mx-auto px-4 py-20">
  <HeadingText title={title} description={description} variant="green" />
  <div class="flex flex-row gap-4">

    <div class={`${adsSiderbarMobile?.ads.length > 0 ? "md:pr-52" : ""} md:mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4`}>
      { 
        itemsCard.map((item: any) => (
          item.type === "content" ? (
            <CardContent
              {...item.data}
            />
          ) : (
            <AdCard
              ads={adsCard?.ads}
            />
          )
        ))
      }
      <AdCard ads={adsSiderbarMobile?.ads} type="secondary"/>
    </div>

  </div>
  {
    cta && (
      <div class="flex items-center justify-center mt-6">
        {
          cta.map(({href, label, isExternal, variant}: any) => (
            <LinkCta href={href} label={label} isExternal={isExternal} type={variant.toUpperCase()}>
              <ArrowRightIcon class="h-6 w-6 ml-2" />
            </LinkCta>
          ))
        }
      </div>
  )}
</section>
