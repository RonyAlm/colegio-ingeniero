---
import AdCard from "./AdCard.astro";
import CardContent from "./CardContent.astro";
import HeadingText from "./HeadingText.astro";
import LinkCta from "./LinkCta.astro";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
const { data } = Astro.props;
if(!data) return
const { title, description, cta, items } = data;

const ads = [
  {
    id: 1,
    title: "Ad 1",
    description: "Ad description",
    image: "https://res.cloudinary.com/du86bx5o0/image/upload/v1784816443/ad_card_1_09a215bd8b.jpg",
    cta: "https://google.com/1"
  },
  {
    id: 2,
    title: "Ad 2",
    description: "Ad description",
    image: "https://res.cloudinary.com/du86bx5o0/image/upload/v1784816443/ad_card_2_ad186aafb7.jpg",
    cta: "https://google.com/2"
  },
]

const ads2 = [
  {
    id: 1,
    title: "Ad 1",
    description: "Ad description",
    image: "https://res.cloudinary.com/du86bx5o0/image/upload/v1784820270/ad_horizontal_8028cdab33.jpg",
    cta: "https://google.com/1"
  },
  {
    id: 2,
    title: "Ad 2",
    description: "Ad description",
    image: "https://res.cloudinary.com/du86bx5o0/image/upload/v1784816443/ad_card_2_ad186aafb7.jpg",
    cta: "https://google.com/2"
  },
]

let itemsCard = [] as any;

items.forEach((item: any, index : number) => {
  itemsCard.push({
    type: "content",
    data: item
  });

  if(index  === 3) {
    itemsCard.push({
      type: "ad"
    })
  }
})

---

<section id="featured-content" class="container mx-auto px-4 py-20">
  <HeadingText title={title} description={description} variant="green" />
  <div class="flex flex-row gap-4">

    <div class="card md:pr-52 md:mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      { 
        itemsCard.map((item: any) => (
          item.type === "content" ? (
            <CardContent
              {...item.data}
            />
          ) : (
            <AdCard
              ads={ads}
            />
          )
        ))
      }
      <AdCard ads={ads2} type="secondary"/>
    </div>

  </div>
  {
    cta && (
      <div class="flex items-center justify-center mt-6">
        {
          cta.map(({href, label, isExternal, variant}: any) => (
            <LinkCta href={href} label={label} isExternal={isExternal} type={variant.toUpperCase()}>
              <ArrowRightIcon class="h-6 w-6 ml-2" />
            </LinkCta>
          ))
        }
      </div>
  )}
</section>

<script>

</script>
