
---
import type { AdLogo } from "../lib/strapi";
import { transformImgUrl } from "../utils";

interface Props {
  ally: AdLogo;
}

const { ally } = Astro.props;
const logoUrl = transformImgUrl(ally.logo?.url || "");
---

<article
  class="group h-full min-w-0 overflow-hidden rounded-xl border border-gray-200 bg-white transition-all duration-200 hover:border-green-600 hover:shadow-md focus-within:border-green-600"
>
  <a
    href={`/aliados/${ally.slug}`}
    aria-label={`Ver información de ${ally.nombre}`}
    class="flex h-full min-w-0 flex-col items-center justify-between focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-green-700"
  >
    <div
      class="flex h-20 w-full items-center justify-center p-2 sm:h-28 sm:p-4 lg:h-32 lg:p-5"
    >
      {logoUrl && (
        <img
          src={logoUrl}
          alt={ally.logo?.alternativeText || `Logo de ${ally.nombre}`}
          width={ally.logo?.width}
          height={ally.logo?.height}
          loading="lazy"
          decoding="async"
          class="block h-full w-full object-contain transition-transform duration-200 group-hover:scale-105"
        />
      )}
    </div>

    <div class="flex min-h-10 w-full items-center justify-center border-t border-gray-100 px-1 py-2 sm:min-h-12 sm:px-3">
      <h3
        class="line-clamp-2 text-center text-[10px] font-semibold leading-tight text-gray-700 sm:text-xs lg:text-sm"
      >
        {ally.nombre}
      </h3>
    </div>
  </a>
</article>
