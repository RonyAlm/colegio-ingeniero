---
import "@splidejs/splide/dist/css/splide.min.css";
import LinkCta from "./LinkCta.astro";
import IngLogo from "./icons/IngLogo.astro";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
import { marked } from "marked";
import { transformImgUrl } from "../utils";
import type { TImagen } from "../types";

interface SliderItem {
  id: number;
  image?: TImagen | null;
  image_movil?: TImagen | null;
  heading?: string | null;
  text?: string | null;
  overlay?: boolean;
  cta?: Array<{ href: string; label: string }>;
}

interface SliderData {
  Slide?: SliderItem[] | null;
}

const { data } = Astro.props as { data?: SliderData | null };

const infoHero = Array.isArray(data?.Slide) ? data.Slide : [];

const parseMarkdown = (value: unknown) =>
  typeof value === "string" && value.trim() ? marked.parse(value) : "";

---

<section class="splide">
  <div class="splide__track">
    <ul class="splide__list">
      {
        infoHero.map((info, index) => {
          const heading = info.heading ?? "";
          const text = parseMarkdown(info.text);
          const desktopImageUrl = info.image?.url
            ? transformImgUrl(info.image.url)
            : "";
          const mobileImageUrl = info.image_movil?.url
            ? transformImgUrl(info.image_movil.url)
            : "";
          const fallbackImageUrl = desktopImageUrl || mobileImageUrl;
          const altText =
            info.image_movil?.alternativeText ||
            info.image?.alternativeText ||
            heading;

          return (
           <li
              class="splide__slide relative aspect-square overflow-hidden bg-green-200/50 md:aspect-[16/5]">
              {fallbackImageUrl && (
                <picture class="absolute inset-0 block h-full w-full">
                  {mobileImageUrl && (
                    <source media="(max-width: 767px)" srcset={mobileImageUrl} />
                  )}
                  <img
                    src={fallbackImageUrl}
                    alt={altText}
                    class="h-full w-full object-cover"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                  />
                </picture>
              )}
              <div class={`relative z-10 px-4 py-20 flex h-full items-center justify-center ${info.overlay ? 'bg-green-700/30 text-white' : ''}`}>
                <div class="container text-center flex flex-col items-center">
                  
                  { 
                    heading.includes("IngeLink") ?
                     <a 
                       href="https://intranet.ingenierosformosa.com.ar/intranet/servicios/ingelink/"
                       class="flex justify-center items-center transition-transform"
                       target="_blank">
                       <IngLogo class="h-20 w-20 text-green-600 " />
                       <span class="text-4xl md:text-6xl text-green-600 text-center text-shadow animate-zoom-in">
                         { heading.split(" ")[0] }
                         <strong class="text-green-100 font-bold text-shadow">{heading.split(" ")[1]}</strong> 
                       </span> 
                      </a> : 
                      <h2 class={`text-2xl md:text-4xl font-bold text-shadow-2xs uppercase
                        ${!info.overlay ? 'text-green-700' : ''}`}>{heading}
                      </h2>
                  }
                  {text && <div class="my-4 mx-6 mx-text-sm text-shadow-neutral-600 md:text-lg max-w-3xl line-clamp-3" set:html={text}></div>}
                   {
                     info.cta && 
                     info.cta.map((cta) => (
                       <LinkCta href={cta.href} label={cta.label} type="WITHBORDER">
                         <ArrowRightIcon class="h-6 w-6 ml-2" />
                       </LinkCta>
                     ))
                   }
                </div>
              </div>
            </li>
          )
        })
      }
     
    </ul>
  </div>
</section>

<script>
  import Splide from "@splidejs/splide";
  import "../styles/global.css";

  new Splide(".splide", {
    type: "loop",
    autoplay: true,
    perPage: 1,
    
  }).mount();


</script>
