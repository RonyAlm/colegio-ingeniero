---
import "@splidejs/splide/dist/css/splide.min.css";
import LinkCta from "./LinkCta.astro";
import IngLogo from "./icons/IngLogo.astro";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
import { marked } from "marked";
import { transformImgUrl } from "../utils";
import type { TImagen } from "../types";

interface SliderItem {
  id: number | string;
  images?: TImagen[] | null;
  image?: TImagen | null;
  image_movil?: TImagen | null;
  heading?: string | null;
  text?: string | null;
  overlay?: boolean;
  cta?: Array<{ href: string; label: string }>;
}

interface SliderData {
  Slide?: SliderItem[] | null;
}

const { data, ads } = Astro.props as {
  data?: SliderData | null;
  ads?: SliderItem[] | null;
};

const infoHero = Array.isArray(data?.Slide) ? data.Slide : [];
let infoHeroWithAd: SliderItem[] = infoHero;

if (Array.isArray(ads) && ads.length > 0) {
  const initialAd = ads[Math.floor(Math.random() * ads.length)];
  const adAdapter: SliderItem = {
    id: `ad-${initialAd.id}`,
    heading: "",
    overlay: false,
    text: "",
    cta: initialAd.cta,
    images: initialAd.images,
  };

  infoHeroWithAd = [adAdapter, ...infoHero];
}

const parseMarkdown = (value: unknown) =>
  typeof value === "string" && value.trim() ? marked.parse(value) : "";
---

<section class="splide">
  <div class="splide__track">
    <ul class="splide__list">
      {
        infoHeroWithAd.map((info, index) => {
          const heading = info.heading ?? "";
          const text = parseMarkdown(info.text);
          const desktopImage = info.images?.[0] || info.image;
          const mobileImage = info.image_movil || info.images?.[1];
          const desktopImageUrl = desktopImage?.url
            ? transformImgUrl(desktopImage.url)
            : "";
          const mobileImageUrl = mobileImage?.url
            ? transformImgUrl(mobileImage.url)
            : "";
          const fallbackImageUrl = desktopImageUrl || mobileImageUrl;
          const altText =
            mobileImage?.alternativeText ||
            desktopImage?.alternativeText ||
            heading;

          return (
            <li class="splide__slide relative aspect-square overflow-hidden bg-green-200/50 md:aspect-[16/5]">
              {fallbackImageUrl && (
                <picture class="absolute inset-0 block h-full w-full">
                  {mobileImageUrl && (
                    <source media="(max-width: 767px)" srcset={mobileImageUrl} />
                  )}
                  <img
                    src={fallbackImageUrl}
                    alt={altText}
                    class="h-full w-full object-cover"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                  />
                </picture>
              )}

              <div class={`relative z-10 flex h-full items-center justify-center px-4 py-20 ${info.overlay ? "bg-green-700/30 text-white" : ""}`}>
                <div class="container flex flex-col items-center text-center">
                  {
                    heading.includes("IngeLink") ? (
                      <a
                        href="https://intranet.ingenierosformosa.com.ar/intranet/servicios/ingelink/"
                        class="flex items-center justify-center transition-transform"
                        target="_blank"
                      >
                        <IngLogo class="h-20 w-20 text-green-600" />
                        <span class="animate-zoom-in text-center text-4xl text-green-600 text-shadow md:text-6xl">
                          {heading.split(" ")[0]}
                          <strong class="font-bold text-green-100 text-shadow">
                            {heading.split(" ")[1]}
                          </strong>
                        </span>
                      </a>
                    ) : (
                      <h2 class={`text-2xl font-bold uppercase text-shadow-2xs md:text-4xl ${!info.overlay ? "text-green-700" : ""}`}>
                        {heading}
                      </h2>
                    )
                  }

                  {text && (
                    <div
                      class="mx-6 my-4 max-w-3xl line-clamp-3 mx-text-sm text-shadow-neutral-600 md:text-lg"
                      set:html={text}
                    />
                  )}

                  {info.cta?.map((cta) => (
                    <div class={`mt-6 flex items-end justify-center ${!heading.trim() ? "absolute bottom-2 z-10 md:bottom-8" : ""}`}>
                      <LinkCta href={cta.href} label={cta.label} type="WITHBORDER">
                        <ArrowRightIcon class="ml-2 h-6 w-6" />
                      </LinkCta>
                    </div>
                  ))}
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  import Splide from "@splidejs/splide";
  import "../styles/global.css";

  new Splide(".splide", {
    type: "loop",
    autoplay: true,
    perPage: 1,
    breakpoints: {
      640: {
        pagination: false,
      },
    },
  }).mount();
</script>
