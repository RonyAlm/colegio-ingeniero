---
import "@splidejs/splide/dist/css/splide.min.css";
import LinkCta from "./LinkCta.astro";
import IngLogo from "./icons/IngLogo.astro";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
import { marked } from "marked";

const { data, ads } = Astro.props;
if(!data) return 

const { Slide: infoHero } = data;

let infoHeroWithAd = infoHero;

if(ads?.length > 0) {

    let randomAd = Math.floor(Math.random() * ads.length);
    const initialAd = ads[randomAd];

    const adAdapter = {
      id: `ad-${initialAd.id}`,
      heading: "",
      overlay: false,
      text: "",
      cta: initialAd.cta,
      images: initialAd.images
    }

     infoHeroWithAd = [ adAdapter, ...infoHero ];
}

---

<section class="splide h-fit md:h-100">
  <div class="splide__track">
    <ul class="splide__list">
      {
        infoHeroWithAd.map((info: any) => (
           <li
              class={ `splide__slide relative bg-center h-full md:h-100 bg-no-repeat bg-cover aspect-square ` } >
              
              { info.images &&
                <picture class="absolute inset-0 -z-10">
                  <source
                    media="(max-width: 767px)"
                    srcset={info.images?.[1]?.url}
                  />

                  <img
                    src={info.images?.[0]?.url}
                    alt={info.heading}
                    class="w-full h-full object-cover"
                  />
                </picture>
              }

              <div class={`relative px-4 py-20 flex h-full items-center justify-center  ${info.overlay ? 'bg-green-700/30 text-white' : ''}`}>
                <div class="container text-center flex flex-col items-center">
                  
                  { 
                    info.heading?.includes("IngeLink") ?
                     <a 
                       href="https://intranet.ingenierosformosa.com.ar/intranet/servicios/ingelink/"
                       class="flex justify-center items-center transition-transform"
                       target="_blank">
                       <IngLogo class="h-20 w-20 text-green-600 " />
                       <span class="text-4xl md:text-6xl text-green-600 text-center text-shadow animate-zoom-in">
                         { info.heading.split(" ")[0] }
                         <strong class="text-green-100 font-bold text-shadow">{info.heading.split(" ")[1]}</strong> 
                       </span> 
                      </a> : 
                      <h2 class={`text-2xl md:text-4xl font-bold text-shadow-2xs uppercase
                        ${!info.overlay ? 'text-green-700' : ''}`}>{info.heading}
                      </h2>
                  }
                  { info.text && info.text.trim() !== '' && 
                    <div class="my-4 mx-6 mx-text-sm text-shadow-neutral-600 md:text-lg max-w-3xl line-clamp-3"
                    set:html={marked.parse(info.text)} />
                  }
                  {  
                     info.cta && 
                     info.cta.map((cta: any) => (
                      <div class={`flex items-end justify-center mt-6 
                        ${(!info.heading || info.heading?.trim() === '') ?
                         'absolute bottom-2 md:bottom-8 z-10' : ''}` }>
                        <LinkCta href={cta.href} label={cta.label} type="WITHBORDER">
                         <ArrowRightIcon class="h-6 w-6 ml-2" />
                       </LinkCta>
                      </div>
                     ))
                  }
                </div>
              </div>
            </li>
        ))
      }
     
    </ul>
  </div>
</section>

<script>
  import Splide from "@splidejs/splide";
  import "../styles/global.css";

  new Splide(".splide", {
    type: "loop",
    autoplay: true,
    perPage: 1,
    breakpoints: {
      640: {
        pagination: false,
      },
      768: {
        perPage: 1,
      },
      1024: {
        perPage: 1,
      },
    }
    
  }).mount();

</script>
