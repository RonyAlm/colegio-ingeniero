---
interface Logo {
  src: string;
  alt: string;
  href?: string;
}

interface Props {
  logos: Logo[];
  speed?: number;
}

const { logos, speed = 30 } = Astro.props;
---

<section class="w-full overflow-hidden">
  <div
    class="flex w-max animate-logo-slider hover:animate-play-paused"
    style={`--slider-duration: ${speed}s`}
  >
    <!-- Grupo 1 -->
    <div class="flex shrink-0 items-center">
      {
        logos.map((logo) => (
          <div class="flex h-72 w-60 shrink-0 items-center justify-center px-6">
            {logo.href ? (
              <a href={logo.href} target="_blank" rel="noopener noreferrer">
                <img
                  src={logo.src}
                  alt={logo.alt}
                  loading="lazy"
                  class="max-h-40 max-w-full object-contain grayscale opacity-70
                   transition-all duration-300 hover:scale-105 hover:grayscale-0 hover:opacity-100"
                />
              </a>
            ) : (
              <img
                src={logo.src}
                alt={logo.alt}
                loading="lazy"
                class="max-h-40 max-w-full object-contain grayscale opacity-70 transition-all duration-300 hover:scale-105 hover:grayscale-0 hover:opacity-100"
              />
            )}
          </div>
        ))
      }
    </div>

    <!-- Grupo 2 -->
    <div
      class="flex shrink-0 items-center"
      aria-hidden="true"
    >
      {
        logos.map((logo) => (
          <div class="flex h-72 w-60 shrink-0 items-center justify-center px-6">
            <img
              src={logo.src}
              alt=""
              loading="lazy"
              class="max-h-40 max-w-full object-contain grayscale opacity-70 transition-all duration-300 hover:scale-105 hover:grayscale-0 hover:opacity-100"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes logo-slider {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  .animate-logo-slider {
    animation: logo-slider var(--slider-duration) linear infinite;
  }
</style>