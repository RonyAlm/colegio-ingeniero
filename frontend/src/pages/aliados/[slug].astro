---
import type { GetStaticPaths } from "astro";
import ArrowTROnIcon from "../../components/icons/ArrowTROnIcon.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getAdLogoInfo,
  getAllAdLogoSlugs,
} from "../../lib/strapi";
import { transformImgUrl } from "../../utils";

export const getStaticPaths = (async () => {
  const slugs = await getAllAdLogoSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/404");

const ally = await getAdLogoInfo(slug);
if (!ally) return Astro.redirect("/404");

const logoUrl = transformImgUrl(ally.logo?.url || "");
---

<Layout
  title={`${ally.nombre} | Aliados`}
  description={ally.descripcion || `${ally.nombre}, aliado del Colegio Público de Ingenieros de Formosa.`}
>
  <div class="container mx-auto my-4 rounded-2xl bg-gray-100 py-10">
    <article class="prose mx-auto max-w-3xl px-8 py-8 md:px-0">
      <div class="flex flex-col items-center justify-center">
        <nav aria-label="Migas de pan" class="not-prose flex items-center text-sm uppercase text-gray-500">
          <a href="/aliados" class="hover:text-green-700 hover:underline">Aliados</a>
          <span class="mx-2" aria-hidden="true">/</span>
          <span class="line-clamp-1">{ally.nombre}</span>
        </nav>

        <h2 class="mt-8 text-center text-3xl font-bold text-gray-800 md:text-4xl">{ally.nombre}</h2>

        {ally.descripcion && (
          <p class="text-center text-sm text-gray-600 md:text-base">{ally.descripcion}</p>
        )}

        <figure class="mb-0 flex w-full justify-center border-gray-200 md:border-2 md:p-6">
          <img
            src={logoUrl}
            alt={ally.logo?.alternativeText || `Logo de ${ally.nombre}`}
            width={ally.logo?.width}
            height={ally.logo?.height}
            style="object-fit: contain;"
            class="max-h-112 w-full rounded-2xl bg-white p-8 object-contain shadow md:p-12"
          />
        </figure>

        {ally.enlace && (
          <a
            href={ally.enlace}
            target="_blank"
            rel="noopener noreferrer"
            class="not-prose mt-8 inline-flex items-center rounded-full bg-green-700 px-5 py-3 text-sm font-semibold uppercase text-white transition-colors hover:bg-green-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700"
          >
            Visitar sitio web
            <ArrowTROnIcon class="ml-2 h-5 w-5" />
          </a>
        )}
      </div>
    </article>
  </div>
</Layout>
