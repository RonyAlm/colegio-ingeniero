
---
import AdLogoCard from "../components/AdLogoCard.astro";
import HeaderPage from "../components/HeaderPage.astro";
import Layout from "../layouts/Layout.astro";
import {
  getAdLogos,
  type AdLogo,
} from "../lib/strapi";

const allies = await getAdLogos();
---

<Layout
  title="Aliados | Colegio Público de Ingenieros de Formosa"
  description="Empresas e instituciones aliadas del Colegio Público de Ingenieros de Formosa."
>
  <HeaderPage
    title="Aliados"
    slug="aliados"
    cover="https://res.cloudinary.com/du86bx5o0/image/upload/v1787616364/cover_aliados_d42bc0c1f7.jpg"
  />

  <main class="bg-gray-100 py-8 sm:py-12">
    <section class="container mx-auto px-3 sm:px-6">

      <div class="mb-8 flex flex-col items-center text-center">
        <h2 class="mb-3 text-3xl font-bold text-green-700 sm:text-4xl">
          Aliados
        </h2>

        <p class="max-w-2xl text-sm leading-relaxed text-gray-600 sm:text-base">
          Instituciones y empresas que acompañan el desarrollo profesional de la ingeniería en Formosa.
        </p>
      </div>

      {
        allies.length > 0 ? (
          <div
            class="mx-auto grid max-w-7xl grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-4 lg:grid-cols-4 lg:gap-5"
          >
            {allies.map((ally: AdLogo) => (
              <AdLogoCard ally={ally} />
            ))}
          </div>
        ) : (
          <section class="mx-auto max-w-2xl border-y border-gray-300 py-12 text-center">
            <h2 class="text-2xl font-semibold text-gray-800">
              Próximamente
            </h2>
            <p class="mt-2 text-gray-600">
              Estamos incorporando la información de nuestros aliados.
            </p>
          </section>
        )
      }
    </section>
  </main>
</Layout>
